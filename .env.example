# PostHog analytics. Prefer credentials (bin/rails credentials:edit → posthog: project_token, host);
# these are the fallback.
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://us.i.posthog.com

# Lapse (https://lapse.hackclub.com), whose timelapses a ship's reviewer sees (Lapse, ShipEvidence). Prefer
# credentials (lapse: program_key, timelapse:read); with no key the integration does nothing. LAPSE_URL and
# LAPSE_API_URL only for a local Lapse.
LAPSE_PROGRAM_KEY=pk_lapse_your_program_key_here
