<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wrong Tool" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="wrong tool">
    <meta name="application-name" content="Wrong Tool">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Privacy-friendly analytics by Plausible %>
    <script async src="https://plausible.io/js/pa-Dp9oCKesz-3dzHt8a_4bp.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <%= render "layouts/posthog" %>
  </head>

  <%# While an admin's viewing as someone, the browser isn't identified as them: it's the admin's. %>
  <%= tag.body data: { posthog_user_id: impersonating? ? nil : current_user&.posthog_distinct_id } do %>
    <%= yield %>
    <%= render "layouts/impersonation" if impersonating? %>
  <% end %>
</html>
