<%# The document's name (renamable), the star and the menu bar. Menu items send menu-bar:command to the
    sheet, like the toolbar's buttons; undo and redo follow the sheet editor (sheet-editor:format).
    During onboarding (and on your project) the name is the file your answers add up to, Start building gives way
    to how far along you are, and once you're signed in, your initial. %>
<% onboarding = local_assigns.fetch(:onboarding, false) %>
<% file_name = local_assigns.fetch(:file_name, "untitled_wrong_game") %>
<% progress = local_assigns.fetch(:progress, "Step 1 of 4") %>
<% user = local_assigns[:user] %>
<header class="app-bar" data-controller="<%= "document-title " unless onboarding %>menu-bar"
        data-action="<%= "menu-bar:rename->document-title#rename " unless onboarding %>sheet-editor:format@window->menu-bar#reflect
                     mousedown@window->menu-bar#dismiss keydown@window->menu-bar#shortcut resize@window->menu-bar#close">
  <%= image_tag "brand/wrong-tool.svg", alt: "", class: "app-bar__logo" %>

  <div class="app-bar__document">
    <div class="app-bar__title-row">
      <% if onboarding %>
        <span class="app-bar__title app-bar__title--file" data-onboarding-target="fileName"><%= file_name %></span>
        <%= inline_svg_tag "icons/header/star.svg", class: "icon app-bar__status-icon", aria_hidden: true %>
        <%= inline_svg_tag "icons/header/drive-file-move.svg", class: "icon app-bar__status-icon", aria_hidden: true %>
        <%= inline_svg_tag "icons/onboarding/cloud-off.svg", class: "icon app-bar__status-icon onboarding__unsaved-only", aria_hidden: true %>
        <%= inline_svg_tag "icons/header/cloud-done.svg", class: "icon app-bar__status-icon onboarding__saved-only", aria_hidden: true %>
      <% else %>
        <input class="app-bar__title" value="wrong tool" size="10" aria-label="Rename" autocomplete="off" spellcheck="false"
               data-document-title-target="input" data-default="wrong tool"
               data-action="focus->document-title#begin keydown->document-title#key blur->document-title#commit">
        <button type="button" class="app-bar__status-icon app-bar__star" aria-label="Star" aria-pressed="false"
                data-document-title-target="star" data-action="document-title#star">
          <%= inline_svg_tag "icons/header/star.svg", class: "icon app-bar__star-outline", aria_hidden: true %>
          <svg class="icon app-bar__star-filled" viewBox="0 -960 960 960" aria-hidden="true"><path d="m233-80 65-281L80-550l288-25 112-265 112 265 288 25-218 189 65 281-247-149L233-80Z"/></svg>
        </button>
        <% %w[drive-file-move cloud-done].each do |name| %>
          <%= inline_svg_tag "icons/header/#{name}.svg", class: "icon app-bar__status-icon", aria_hidden: true %>
        <% end %>
      <% end %>
    </div>

    <nav class="menu-bar" role="menubar" aria-label="Menu"
         data-action="mousedown->menu-bar#hold keydown->menu-bar#navigate">
      <% menu_bar_menus.each do |name, items| %>
        <div class="menu-bar__menu" data-menu-bar-target="menu">
          <button type="button" class="menu-bar__item" role="menuitem" aria-haspopup="menu" aria-expanded="false"
                  data-action="click->menu-bar#toggle mouseenter->menu-bar#hover mouseleave->menu-bar#unhover"><%= name %></button>
          <%= render "pages/menu_items", items:, label: name %>
        </div>
      <% end %>
    </nav>
  </div>

  <div class="app-bar__actions">
    <% %w[history comment].each do |name| %>
      <button type="button" class="app-bar__round-button" aria-label="<%= name.humanize %>">
        <%= inline_svg_tag "icons/header/#{name}.svg", class: "icon", aria_hidden: true %>
      </button>
    <% end %>

    <button type="button" class="app-bar__meet-button" aria-label="Meet">
      <%= inline_svg_tag "icons/header/videocam.svg", class: "icon", aria_hidden: true %>
      <%= inline_svg_tag "icons/arrow-drop-down.svg", class: "icon", aria_hidden: true %>
    </button>

    <% if onboarding %>
      <span class="app-bar__progress" data-onboarding-target="progress"><%= progress %></span>
      <% if user %>
        <%# Your account: who you're signed in as, and logging out. %>
        <button type="button" class="app-bar__avatar" popovertarget="app-bar-account" aria-label="Account: <%= user.name %>">
          <%= (user.first_name.presence || user.name.to_s)[0]&.upcase %>
        </button>
        <div class="app-bar__account" id="app-bar-account" popover>
          <p class="app-bar__account-name"><%= user.name %></p>
          <% if user.email.present? %><p class="app-bar__account-email"><%= user.email %></p><% end %>
          <%= button_to "Log out", logout_path, method: :delete, class: "menu-bar__entry app-bar__logout" %>
        </div>
      <% end %>
    <% else %>
      <%= link_to onboarding_path, class: "app-bar__build-button" do %>
        <span class="app-bar__build-label"><%= inline_svg_tag "icons/header/sports-esports.svg", class: "icon", aria_hidden: true %><span>Start<span class="app-bar__build-rest"> building</span></span></span>
        <span class="app-bar__build-caret"><%= inline_svg_tag "icons/arrow-drop-down.svg", class: "icon", aria_hidden: true %></span>
      <% end %>
    <% end %>
  </div>

  <%# Help > Keyboard shortcuts (Ctrl+/) %>
  <dialog class="menu-dialog menu-dialog--shortcuts" aria-labelledby="shortcuts-title"
          data-menu-bar-target="shortcuts" data-action="click->menu-bar#backdrop close->menu-bar#closed">
    <div class="menu-dialog__header">
      <h2 class="menu-dialog__title" id="shortcuts-title">Keyboard shortcuts</h2>
      <input type="search" class="menu-dialog__search" placeholder="Search keyboard shortcuts" aria-label="Search keyboard shortcuts"
             autocomplete="off" spellcheck="false" data-menu-bar-target="shortcutSearch" data-action="input->menu-bar#filterShortcuts">
      <button type="button" class="menu-dialog__close" aria-label="Close" data-action="menu-bar#closeDialog">
        <svg class="icon" viewBox="0 -960 960 960" aria-hidden="true"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg>
      </button>
    </div>
    <div class="menu-dialog__body">
      <% keyboard_shortcut_groups.each do |group, shortcuts| %>
        <section class="menu-dialog__group" data-menu-bar-target="shortcutGroup">
          <h3 class="menu-dialog__group-title"><%= group %></h3>
          <% shortcuts.each do |label, keys| %>
            <div class="menu-dialog__shortcut">
              <span><%= label %></span>
              <kbd class="menu-dialog__keys" data-shortcut="<%= keys %>"><%= keys %></kbd>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>
  </dialog>

  <%# Insert > Link and Insert > Comment ask for their text here. %>
  <dialog class="menu-dialog menu-dialog--prompt" aria-labelledby="menu-prompt-title"
          data-menu-bar-target="prompt" data-action="click->menu-bar#backdrop close->menu-bar#closed">
    <form method="dialog" data-action="submit->menu-bar#submitPrompt">
      <h2 class="menu-dialog__title" id="menu-prompt-title" data-menu-bar-target="promptTitle"></h2>
      <input class="menu-dialog__input" autocomplete="off" spellcheck="false" aria-labelledby="menu-prompt-title"
             data-menu-bar-target="promptInput">
      <div class="menu-dialog__buttons">
        <button type="button" class="menu-dialog__button" data-action="menu-bar#closeDialog">Cancel</button>
        <button class="menu-dialog__button menu-dialog__button--primary">OK</button>
      </div>
    </form>
  </dialog>
</header>
