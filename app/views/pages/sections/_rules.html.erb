<% short = "Lorem ipsum dolor sit amet, consectetur adipiscing elit." %>
<% medium = "Sed do eiusmod tempor incididunt ut labore." %>
<% rules = [
     [ short, true ], [ medium, true ], [ "Lorem ipsum dolor", false ], [ "Sit amet consectetur", false ],
     [ medium, false ], [ short, true ], [ medium, true ], [ "Lorem ipsum dolor sit", true ]
   ] %>

<h2 class="cell cell--heading rules__title">Lorem ipsum dolor sit amet in medium.</h2>

<div class="sheet__rows rules__list">
  <span class="cell cell--table-header rules__rule">Rule</span>
  <span class="cell cell--table-header rules__allowed">Allowed?</span>

  <% rules.each_with_index do |(rule, allowed), index| %>
    <span class="cell rules__rule"><%= rule %></span>
    <%= tag.span allowed.to_s.upcase, class: [ "cell rules__allowed", allowed ? "cell--true" : "cell--false" ],
          data: { formula: "=RUNS_IN_MEDIUM(B#{index + 6}) → #{allowed.to_s.upcase}" } %>
  <% end %>
</div>

<p class="cell cell--formula rules__note">Lorem ipsum: dolor sit amet, consectetur adipiscing elit.</p>
