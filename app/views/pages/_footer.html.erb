<%# Sits two rows below each sheet's content; the section's stylesheet sets --footer-row. %>
<p class="cell cell--body sheet-footer__text"><span><%= footer_credit %></span></p>

<nav class="sheet-footer__links" aria-label="Hack Club">
  <% footer_links.each do |name, url| %>
    <%= link_to name, url, class: "cell cell--link", target: "_blank", rel: "noopener",
          data: { formula: %(=HYPERLINK("#{url}", "#{name}")) } %>
  <% end %>
</nav>
