<%# The admin pages, so you can get between them (Admin::NavHelper): the one you're on is marked. %>
<nav class="admin__nav" aria-label="Admin pages">
  <% [ { label: "Admin", path: admin_root_path }, *admin_pages ].each do |page| %>
    <%= link_to page[:label], page[:path], aria: { current: ("page" if current_page?(page[:path])) } %>
  <% end %>
</nav>
