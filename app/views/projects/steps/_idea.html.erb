<%# locals: (project:) %>
<p class="project__step-text">One line about what you're building. People will cheer you on.</p>
<p class="project__step-draft"><%= project_idea_post(project) %></p>
<div class="project__step-actions">
  <%= button_to "Post", project_path, method: :patch, params: { project: { idea_posted: true } },
        class: "onboarding-button onboarding-button--primary project__step-button",
        form: { data: { action: "submit->project#open" } }, data: { url: wrong_tool_slack_url } %>
  <%= button_to "Skip", project_path, method: :patch, params: { project: { idea_skipped: true } },
        class: "onboarding-text-button project__step-button" %>
</div>
