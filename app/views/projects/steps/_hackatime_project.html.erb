<%# locals: (project:, refresh: false) %>
<%# Which of your Hackatime projects this build is: a dropdown of them all, each with a checkbox, the linked ones
    ticked. Tick more for time spent across more than one. %>
<% choices = project_hackatime_choices(project, refresh:) %>
<p class="project__step-text">
  Which Hackatime project is this build? Only time from <%= project_date(Program::HACKATIME_START) %> on counts.
</p>
<% if choices[:problem] %>
  <p class="project__step-error" role="alert"><%= choices[:problem] %></p>
  <% if choices[:relink] %><%= render "projects/hackatime_link_button", label: "Link Hackatime again" %><% end %>
<% elsif choices[:projects].none? %>
  <p class="project__step-error" role="alert">No projects on Hackatime yet.</p>
<% else %>
  <% linked = choices[:projects].select { |choice| choice[:linked] } %>
  <%= form_with model: project, url: project_path, method: :patch, class: "project__picker-form",
        data: { controller: "hackatime-picker", action: "change->hackatime-picker#update click@window->hackatime-picker#close" } do |form| %>
    <%= hidden_field_tag "project[hackatime_project_names][]", "", id: nil %>
    <details class="project__picker" data-hackatime-picker-target="dropdown" <%= "open" if linked.none? %>>
      <summary class="project__picker-trigger" aria-label="Hackatime projects">
        <span class="project__picker-value" data-hackatime-picker-target="summary"
              data-placeholder="Pick your Hackatime projects"><%= linked.map { |choice| choice[:name] }.join(", ").presence || "Pick your Hackatime projects" %></span>
        <%= inline_svg_tag "icons/arrow-drop-down.svg", class: "icon project__picker-arrow", aria_hidden: true %>
      </summary>
      <div class="project__picker-list" role="group" aria-label="Your Hackatime projects">
        <% choices[:projects].each do |choice| %>
          <label class="project__picker-option">
            <input type="checkbox" name="project[hackatime_project_names][]" value="<%= choice[:name] %>"
                   class="project__picker-box" <%= "checked" if choice[:linked] %>>
            <span class="project__picker-name"><%= choice[:name] %></span>
            <span class="project__picker-note"><%= choice[:note] %></span>
          </label>
        <% end %>
      </div>
    </details>
    <div class="project__step-actions">
      <%= form.button project_hackatime_link_label(linked.size), class: "onboarding-button onboarding-button--primary project__step-button",
            disabled: linked.none?, data: { hackatime_picker_target: "submit" } %>
      <%= link_to "Refresh", project_path(step: "hackatime_project", refresh: 1), class: "onboarding-text-button project__step-button" %>
    </div>
  <% end %>
<% end %>
<% if project.errors[:hackatime_projects].any? %>
  <p class="project__step-error" role="alert"><%= project.errors.full_messages_for(:hackatime_projects).first %></p>
<% end %>
<p class="project__step-hint">
  <%= project.code_tool? ? "Don't see it? Write a line of code with the extension on, then refresh." : "Don't see it? Log a minute of time on it with Hackatime, then refresh." %>
</p>
