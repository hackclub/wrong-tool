<%# locals: (project:) %>
<%# Your buddy, in the sidebar: an invite to pair up, the invite you've sent, or the two of you and what you'll earn. %>
<% buddy = project.buddy %>
<section class="project__card buddy-card" aria-labelledby="buddy-card-title">
  <% if buddy %>
    <div class="buddy-card__head">
      <span class="buddy-card__faces" aria-hidden="true">
        <%= avatar_tag(project.user, "buddy-face") %><%= avatar_tag(buddy.user, "buddy-face") %>
      </span>
      <span class="buddy-card__who">
        <%= link_to "You + #{buddy_name(buddy)}", buddy_path, class: "buddy-card__title", id: "buddy-card-title" %>
        <span class="buddy-card__note"><%= buddy_name(buddy) %> is building <%= buddy.title.sub(/\A\w/, &:downcase) %></span>
      </span>
      <span class="buddy-card__streak"><b>Week 1</b><span>pair streak</span></span>
    </div>
    <div class="buddy-card__section">
      <span class="buddy-card__caption">Pair rewards · both of you get these</span>
      <ul class="project__rewards buddy-card__rewards">
        <% pair_rewards.each do |reward| %>
          <li class="project__reward" data-state="<%= reward[:state] %>">
            <span class="project__reward-day"><%= reward[:short] %></span>
            <span class="project__reward-label"><%= reward[:reward] %></span>
            <span class="project__reward-status"><%= reward[:status] %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% elsif project.buddy_invited? %>
    <div class="buddy-card__head buddy-card__head--spread">
      <span class="buddy-card__faces" aria-hidden="true">
        <%= avatar_tag(project.user, "buddy-face") %><span class="buddy-face" data-pending>…</span>
      </span>
      <span class="buddy-card__badge">#PENDING</span>
    </div>
    <div class="buddy-card__who">
      <h2 class="buddy-card__title" id="buddy-card-title">Invite sent</h2>
      <p class="buddy-card__note">You're paired the moment they sign up from your link.</p>
    </div>
    <%= render "buddies/invite_link", project:, compact: true %>
  <% else %>
    <span class="buddy-card__faces" aria-hidden="true">
      <%= avatar_tag(project.user, "buddy-face") %><span class="buddy-face" data-empty>+</span>
    </span>
    <div class="buddy-card__who">
      <h2 class="buddy-card__title" id="buddy-card-title">Build with a buddy</h2>
      <p class="buddy-card__note">Pair up with a friend. Separate games, one weekly streak, rewards for both.</p>
    </div>
    <ul class="buddy-card__ladder">
      <% pair_rewards.each do |reward| %>
        <li><span class="buddy-card__ladder-key"><%= reward[:short] %></span><%= reward[:reward].sub(", mailed to both", ", both") %></li>
      <% end %>
    </ul>
    <%= render "buddies/invite_link", project:, mark_invited: true, compact: true %>
    <p class="buddy-card__fine">Rewards only unlock when you both log.</p>
  <% end %>
</section>
