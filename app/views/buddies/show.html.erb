<% content_for :title, "Buddy · Wrong Tool" %>
<% buddy = @buddy %>
<% pair = @project.pair %>

<%# The Buddy tab: how building with a buddy works and your invite link, or once you're paired, the two of you. %>
<div class="spreadsheet onboarding project" data-saved>
  <%= render "pages/app_bar", onboarding: true, file_name: project_file_name(@project),
        progress: buddy ? "Pair weeks · #{pair.pair_weeks} of #{Program::WEEKS.size}" : "No buddy yet", user: current_user %>
  <%= render "pages/toolbar" %>
  <%= render "onboarding/formula_bar", name_box: buddy ? "L2" : "A1",
        formula: buddy ? "=BUDDY(you, #{buddy_name(buddy).downcase})  →  TRUE" : "=BUDDY(you, ?)  →  #N/A" %>

  <main class="project__sheet">
    <% if buddy %>
      <div class="buddy-pair">
        <div class="buddy-pair__main">
          <header class="buddy-pair__header">
            <div class="buddy-pair__who">
              <span class="buddy-card__faces buddy-card__faces--large" aria-hidden="true">
                <%= avatar_tag(current_user, "buddy-face") %><%= avatar_tag(buddy.user, "buddy-face") %>
              </span>
              <h1 class="project__title">You + <%= buddy_name(buddy) %></h1>
              <p class="leaderboard__note"><%= @project.title %> · <%= buddy.title %></p>
            </div>
            <div class="buddy-pair__streak">
              <span class="buddy-pair__streak-label">Pair weeks</span>
              <span class="buddy-pair__streak-value"><%= pair.pair_weeks %> of <%= Program::WEEKS.size %></span>
              <span class="buddy-pair__streak-note"><%= pair_weekly_hours %>h each, every week</span>
            </div>
          </header>
          <%# This week's hours for each of you, against the weekly goal. %>
          <ul class="buddy-hours" aria-label="This week">
            <% [ [ "You", @project ], [ buddy_name(buddy), buddy ] ].each do |name, project| %>
              <% hours = project.hours_this_week %>
              <li class="buddy-hours__row" <%= "data-done" if hours >= pair_weekly_hours %>>
                <span class="buddy-hours__name"><%= name %></span>
                <span class="buddy-hours__bar" aria-hidden="true">
                  <span style="inline-size: <%= [ hours / pair_weekly_hours * 100, 100 ].min.round %>%"></span>
                </span>
                <span class="buddy-hours__value"><%= project_hours(hours) %> of <%= pair_weekly_hours %>h</span>
              </li>
            <% end %>
          </ul>
        </div>

        <aside class="buddy-pair__side">
          <section class="project__card buddy-card">
            <div class="buddy-card__head">
              <%= avatar_tag(buddy.user, "buddy-face buddy-face--large") %>
              <span class="buddy-card__who">
                <span class="buddy-card__title"><%= buddy_name(buddy) %></span>
                <span class="buddy-card__note"><%= buddy.title %> · Day <%= buddy.day_number %></span>
              </span>
            </div>
            <% if (shot = buddy.stored_screenshot) %>
              <%= image_tag url_for(shot), alt: "Screenshot of #{buddy.title}", class: "buddy-card__shot" %>
            <% end %>
          </section>

          <section class="project__card buddy-card" aria-labelledby="pair-rewards-title">
            <h2 class="project__card-title" id="pair-rewards-title">Pair rewards</h2>
            <% pair_rewards(pair).each do |reward| %>
              <div class="buddy-reward" data-state="<%= reward[:state] %>">
                <span class="buddy-reward__text"><span class="buddy-reward__key"><%= reward[:when].upcase %></span><%= reward[:label] %></span>
                <span class="buddy-reward__status"><%= reward[:status] %></span>
              </div>
            <% end %>
            <p class="buddy-card__fine buddy-card__fine--padded">
              A pair week is a week you both log <%= pair_weekly_hours %>h.
            </p>
          </section>
        </aside>
      </div>
    <% else %>
      <div class="buddy-invite">
        <header class="leaderboard__heading">
          <h1 class="project__title">Build with a friend</h1>
          <p class="leaderboard__note">You each make your own game. Weeks you both log <%= pair_weekly_hours %>h count toward a few small rewards.</p>
        </header>

        <div class="buddy-rules" role="table" aria-label="What you both get">
          <% formulas = { "pair_listed" => "=POMODORO(you, them)", "stickers" => "=WEEKS(both≥#{pair_weekly_hours}h) ≥ 1",
                          "pair_shoutout" => "=WEEKS(both≥#{pair_weekly_hours}h) ≥ 2", "desktop" => "=FIRST(both≥#{Reward::DESKTOP_HOURS}h)" } %>
          <% pair_rewards.each.with_index do |reward, index| %>
            <div class="buddy-rules__cell" role="cell">
              <span class="buddy-rules__column" aria-hidden="true"><%= ("A".ord + index).chr %></span>
              <span class="buddy-rules__formula"><%= formulas.fetch(reward[:key]) %></span>
              <span class="buddy-rules__title"><%= reward[:when] %></span>
              <span class="buddy-rules__text"><%= reward[:label] %>. <%= reward[:about] %></span>
            </div>
          <% end %>
        </div>

        <div class="buddy-invite__ways">
          <section class="buddy-invite__way">
            <h2 class="project__section-title">Invite a friend</h2>
            <p class="project__step-text">They sign up with your link, and you're paired.</p>
            <%= render "buddies/invite_link", project: @project, mark_invited: true %>
          </section>
          <section class="buddy-invite__way">
            <h2 class="project__section-title">Match me with someone</h2>
            <p class="project__step-text">We'll pair you with someone at a similar pace.</p>
            <p class="buddy-pair__soon">Matching isn't ready yet.</p>
          </section>
        </div>

        <p class="buddy-sticky">You don't need to use the same tool.</p>
      </div>
    <% end %>
  </main>

  <%= render "onboarding/tabs", current: :buddy, project_open: true %>
</div>
