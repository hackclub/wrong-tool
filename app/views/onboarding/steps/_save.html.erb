<%# A4: your game, headed by the idea you picked, and one button to sign in and start. The receipt shows what
    gets saved. Get started signs in with Hack Club Auth; data-signed flips the panel. %>
<div class="onboarding-save" data-onboarding-target="save" data-signed="false">
  <div class="onboarding-receipt">
    <div class="onboarding-receipt__photo">
      <% onboarding_prizes.each do |prize| %>
        <%= image_tag prize[:image], alt: prize[:alt], class: "onboarding-receipt__image", hidden: true,
              data: { onboarding_target: "receiptPhoto", prize: prize[:id] } %>
      <% end %>
    </div>
    <dl class="onboarding-receipt__rows">
      <div class="onboarding-receipt__row"><dt>Platform</dt><dd class="onboarding-receipt__strong" data-onboarding-target="receiptTool">—</dd></div>
      <div class="onboarding-receipt__row"><dt>Building</dt><dd data-onboarding-target="receiptIdea">#LATER</dd></div>
      <div class="onboarding-receipt__row"><dt>Prize</dt><dd class="onboarding-receipt__strong" data-onboarding-target="receiptPrize">—</dd></div>
    </dl>
  </div>

  <div class="onboarding-save__panel onboarding-save__panel--unsigned">
    <h3 class="onboarding-save__title" data-onboarding-target="gameTitle">Your game.</h3>
    <%# Off to Hack Club Auth and back to /start, where the answers kept in this tab pick up again. %>
    <%= button_to "/auth/hackclub", params: { origin: onboarding_path },
          class: "onboarding-button onboarding-button--primary onboarding-button--large",
          form: { class: "onboarding-save__form", data: { turbo: false, action: "submit->onboarding#signIn" } },
          data: { onboarding_target: "signIn" } do %>
      <%= inline_svg_tag "icons/onboarding/login.svg", class: "icon onboarding-save__login", aria_hidden: true %>
      <%= inline_svg_tag "icons/onboarding/progress-activity.svg", class: "icon onboarding-save__spinner", aria_hidden: true %>
      <span data-onboarding-target="signInLabel">Get started</span>
    <% end %>
    <% if alert %>
      <p class="onboarding-save__error" role="alert"><%= alert %></p>
    <% end %>
  </div>

  <div class="onboarding-save__panel onboarding-save__panel--signed" role="status">
    <h3 class="onboarding-save__title">You're in.</h3>
    <a href="#" class="onboarding-button onboarding-button--primary onboarding-button--large">
      Open my project<%= inline_svg_tag "icons/onboarding/arrow-forward.svg", class: "icon", aria_hidden: true %>
    </a>
  </div>
</div>
