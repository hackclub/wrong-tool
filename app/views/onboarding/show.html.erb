<% content_for :title, "Start building · Wrong Tool" %>

<%# Onboarding is a sheet too: four questions down column A (A1 → A4). The active row opens up, answered rows
    fold back into cells you can reopen, and the file name and formula bar keep a running receipt. %>
<div class="spreadsheet onboarding"
     data-controller="onboarding"
     data-action="pageshow@window->onboarding#resume"
     data-onboarding-tools-value="<%= onboarding_tools.to_json %>"
     data-onboarding-genres-value="<%= onboarding_genres.to_json %>"
     data-onboarding-twists-value="<%= onboarding_twists.to_json %>"
     data-onboarding-taken-value="<%= onboarding_taken_ideas.to_json %>"
     data-onboarding-prizes-value="<%= onboarding_prizes.map { |prize| prize.slice(:id, :name, :full) }.to_json %>"
     data-onboarding-hours-value="<%= hours_per_reward %>"
     data-onboarding-signed-in-value="<%= signed_in? %>"
     data-onboarding-project-url-value="<%= project_path %>"
     data-onboarding-has-project-value="<%= current_user&.project.present? %>"
     data-onboarding-name-value="<%= current_user&.first_name.presence || current_user&.name %>"
     data-onboarding-whoami-url-value="<%= Rails.configuration.x.hack_club_auth_whoami_url unless signed_in? %>"
     data-onboarding-check-ins-value="<%= onboarding_build_times.to_h.to_json %>"
     data-onboarding-program-value="<%= { start: program_dates.begin.iso8601, end: program_dates.end.iso8601 }.to_json %>"
     data-onboarding-sounds-value="<%= { first: asset_path("clippy-congratulate-1.mp3"), second: asset_path("clippy-congratulate-2.mp3") }.to_json %>">
  <%= render "pages/app_bar", onboarding: true %>
  <%= render "pages/toolbar" %>
  <%= render "onboarding/formula_bar" %>

  <div class="onboarding__sheet">
    <div class="onboarding__column-headers" aria-hidden="true">
      <span class="onboarding__corner"></span>
      <% ("A".."Z").each do |letter| %>
        <%= tag.span letter, class: [ "onboarding__column-header", ("onboarding__column-header--selected" if letter == "A") ] %>
      <% end %>
    </div>

    <div class="onboarding__rows">
      <% onboarding_steps.each.with_index(1) do |step, number| %>
        <%= render "onboarding/row", step:, number: %>
      <% end %>
    </div>
  </div>

  <%= render "onboarding/tabs", project_open: current_user&.project.present? %>
</div>
