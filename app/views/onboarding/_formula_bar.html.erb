<%# Read-only here: the name box follows the open row and the formula shows what you've answered so far. %>
<div class="formula-bar">
  <span class="formula-bar__name-box">
    <span class="formula-bar__name" data-onboarding-target="nameBox">A1</span>
    <%= inline_svg_tag "icons/arrow-drop-down.svg", class: "icon", aria_hidden: true %>
  </span>
  <span class="formula-bar__divider"></span>
  <span class="formula-bar__fx">fx</span>
  <output class="formula-bar__content onboarding__formula" data-onboarding-target="formula">=PICK(wrong_tool)</output>
</div>
