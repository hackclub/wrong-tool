<%# locals: (ship:, decision:) %>
<%# Deciding it: approve, ask for changes, reject or send it on, then only that one's fields (CSS:
    .review__form:has(...)). The note goes to them in Clippy's DM; the justification is for staff (and, sending it on,
    for whoever gets it). Approving takes what you checked, and the hours: all the project has now (not just what it had when shipped), or
    fewer with why. %>
<%= form_with model: decision, scope: :review, url: review_ship_decisions_path(ship), method: :post, class: "review__form",
      data: { turbo: false } do |form| %>
  <% if decision.errors.any? %>
    <ul class="review__errors" role="alert">
      <% decision.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>

  <fieldset class="review__verdicts">
    <legend class="visually-hidden">Decision</legend>
    <% { "approved" => "Approve", "changes_requested" => "Request changes", "rejected" => "Reject", "hold" => "Send on" }.each do |value, label| %>
      <label class="review__verdict">
        <%= form.radio_button :decision, value, checked: value == (decision.hold? ? "hold" : decision.decision) %>
        <span><%= label %></span>
      </label>
    <% end %>
  </fieldset>

  <p class="review__hint" data-when="approved">The hours go to them to spend in the shop.</p>
  <p class="review__hint" data-when="changes_requested">They get <%= Ship::CHANGES_DAYS %> days to make them and ship again, even after shipping's closed.</p>
  <p class="review__hint" data-when="rejected">Final: they can't ship again. For ships that shouldn't be here at all; anything honest that falls short is a request for changes.</p>
  <p class="review__hint" data-when="hold">Not yours to call: it leaves the queue for whoever you send it to, with your note. They're told nothing.</p>

  <fieldset class="review__field review__holds" data-when="hold">
    <legend>Send it to</legend>
    <% if ship.fraud_unchecked? %>
      <label><%= form.radio_button :hold, "fraud", checked: decision.decision != "send_admin" %> Fraud: it's back here once the fraud check passes</label>
    <% end %>
    <label><%= form.radio_button :hold, "admin", checked: decision.decision == "send_admin" || !ship.fraud_unchecked? %> An admin: it's theirs to decide</label>
  </fieldset>

  <div class="review__field" data-when="approved">
    <%= form.label :approved_hours, "Hours to approve" %>
    <%= form.number_field :approved_hours, value: (decision.approved_hours || ship.hours_now).to_f.round(2), min: 0,
          max: ship.hours_now.round(2), step: 0.01, class: "admin__hours" %>
    <small class="admin__muted">of <%= project_hours(ship.hours_now) %> it has now<% if ship.hours_now > ship.hours %> (<%= project_hours(ship.hours) %> when shipped)<% end %></small>
  </div>
  <div class="review__field" data-when="approved">
    <%= form.label :deflation_reason, "Why fewer, if fewer" %>
    <%= form.text_area :deflation_reason, rows: 2 %>
  </div>

  <div class="review__field" data-when="approved changes_requested rejected">
    <%= form.label :note_to_maker do %>
      <span data-when="approved">Note to them (optional)</span>
      <span data-when="changes_requested">What to change (they'll read it)</span>
      <span data-when="rejected">Why not (they'll read it)</span>
    <% end %>
    <%= form.text_area :note_to_maker, rows: 4 %>
  </div>

  <div class="review__field">
    <%= form.label :justification do %>
      <span data-when="approved">What you checked, and what's in it (staff only)</span>
      <span data-when="changes_requested rejected">Anything for staff (optional)</span>
      <span data-when="hold">What they should look at</span>
    <% end %>
    <%= form.text_area :justification, rows: 4 %>
  </div>

  <div class="review__field" data-when="approved">
    <%= form.label :video_url, "A recording of you playing it (optional)" %>
    <%= form.url_field :video_url, placeholder: "https://", spellcheck: false %>
  </div>

  <%= form.submit "Submit", class: "admin__button review__submit" %>
<% end %>
