<%# locals: (ship:) %>
<%# One ship in the list: who, their project, what they shipped (a link to it in full, unless it's yours), the hours
    it took, when, and where it stands. %>
<% project = ship.project %>
<% user = project.user %>
<tr id="<%= dom_id(ship) %>" data-status="<%= ship.status %>">
  <th scope="row">
    <%= avatar_tag(user, "admin__avatar", aria: { hidden: true }, role: nil, title: nil) %>
    <%= user.name.presence || user.public_name %>
    <small class="admin__muted"><%= user.email %><% if user.slack_display_name.present? %> · <%= user.slack_display_name %><% end %></small>
  </th>
  <td>
    <% if current_user.may_review?(ship) %>
      <%= link_to ship.title, review_ship_path(ship) %>
    <% else %>
      <%= ship.title %> <span class="admin__muted">(yours)</span>
    <% end %>
    <small class="admin__muted"><%= project.tool_name %> · <%= ship.hackatime_projects.join(", ").presence || "no Hackatime project" %></small>
  </td>
  <td class="leaderboard__number"><%= project_hours(ship.hours) %></td>
  <td><%= ship.created_at.strftime("%b %-d") %></td>
  <td data-decision="<%= ship.status %>">
    <%= ship_status_label(ship) %>
    <% unless ship.in_review? %>
      <small class="admin__muted"><%= reviewer_name(ship.decided_by) %> · <%= ship.decided_at.strftime("%b %-d") %></small>
    <% end %>
  </td>
</tr>
