<%# locals: (decision:, current:) %>
<%# One call on a ship: what, who, when, the hours it granted, and what they wrote: the note the maker got, and the
    justification only staff see. One on an earlier ship says which. %>
<li class="review__call" id="<%= dom_id(decision) %>" data-decision="<%= decision.decision %>">
  <p class="review__call-head">
    <strong><%= review_decision_label(decision) %></strong>
    · <%= reviewer_name(decision.reviewer) %> · <%= decision.created_at.strftime("%b %-d, %H:%M") %>
    <% if decision.approved? && decision.approved_hours %>· <%= project_hours(decision.approved_hours) %> hrs<% end %>
    <% unless current %><span class="admin__muted">· an earlier ship (<%= project_hours(decision.ship.hours) %> hrs)</span><% end %>
  </p>
  <% if decision.note_to_maker.present? %>
    <p class="review__call-text"><span class="admin__muted">To them:</span> <%= decision.note_to_maker %></p>
  <% end %>
  <% if decision.justification.present? %>
    <p class="review__call-text"><span class="admin__muted">Staff only:</span> <%= decision.justification %></p>
  <% end %>
  <% if decision.deflation_reason.present? %>
    <p class="review__call-text"><span class="admin__muted">Fewer hours because:</span> <%= decision.deflation_reason %></p>
  <% end %>
  <% if decision.video_url.present? %>
    <p class="review__call-text"><%= link_to "Their recording of it", decision.video_url, target: "_blank", rel: "noopener" %></p>
  <% end %>
</li>
