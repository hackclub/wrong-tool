<%# locals: (ship:) %>
<%# For admins, on an approved ship (or one approved and waiting on the fraud check): changing the hours it grants,
    with why (staff only; the maker isn't told). Kept in its history as "Hours changed". %>
<details class="review__change-hours">
  <summary>Change the hours</summary>
  <%= form_with scope: :review, url: review_ship_hours_path(ship), method: :patch, class: "review__form", data: { turbo: false } do |form| %>
    <div class="review__field">
      <%= form.label :approved_hours, "Hours to approve" %>
      <%= form.number_field :approved_hours, value: (ShipReview.granted_hours(ship) || ship.hours).to_f.round(2), min: 0,
            max: ship.hours.to_f.round(2), step: 0.01, class: "admin__hours", required: true %>
      <small class="admin__muted">of <%= project_hours(ship.hours) %> it took</small>
    </div>
    <div class="review__field">
      <%= form.label :justification, "Why (staff only)" %>
      <%= form.text_area :justification, rows: 2, required: true, minlength: ReviewDecision::NOTE_MIN %>
    </div>
    <%= form.submit "Change hours", class: "admin__button" %>
  <% end %>
</details>
