<% content_for :title, "Stats · Wrong Tool" %>
<% totals, streaks = @stats[:totals], @stats[:streaks] %>
<% day = @stats[:day].clamp(0, @stats[:days]) %>
<% daily = @stats[:daily] %>
<% axis_max = stat_axis_max(daily.filter_map { |d| d[:hours] }.max) %>
<% peak = daily.select { |d| d[:hours] }.max_by { |d| d[:hours] } %>

<%# wrong tool in numbers (PublicStats), for anyone: totals only, and "<3" for any group too small to show. %>
<div class="spreadsheet onboarding project">
  <%= render "pages/app_bar" %>
  <%= render "onboarding/formula_bar", name_box: "A1", formula: "=SUM(hours)  →  #{stat(totals[:hours])}" %>

  <main class="project__sheet">
    <div class="stats" data-controller="stats-tooltip"
         data-action="pointerover->stats-tooltip#show focusin->stats-tooltip#show pointerout->stats-tooltip#hide focusout->stats-tooltip#hide">
      <header>
        <h1 class="project__title">wrong tool in numbers</h1>
        <p class="leaderboard__note">
          <% if day < 1 %>Starts <%= Program::DATES.begin.strftime("%b %-d") %>.<% elsif @stats[:day] > @stats[:days] %>That's a wrap.<% else %>Day <%= day %> of <%= @stats[:days] %>.<% end %>
          Totals across everyone, never anyone on their own; groups under <%= PublicStats::MIN_GROUP %> people show as "&lt;<%= PublicStats::MIN_GROUP %>".
        </p>
      </header>

      <section class="stats__tiles" aria-label="Totals">
        <div class="stats__tile"><span>Builders</span><strong><%= stat(totals[:builders]) %></strong></div>
        <div class="stats__tile"><span>Hours built</span><strong><%= stat(totals[:hours]) %></strong></div>
        <div class="stats__tile"><span>Games shipped</span><strong><%= stat(totals[:shipped]) %></strong></div>
        <div class="stats__tile"><span>Handhelds earned</span><strong><%= stat(totals[:handhelds]) %></strong></div>
      </section>

      <section class="stats__card" aria-labelledby="stats-daily">
        <h2 class="stats__heading" id="stats-daily">Hours built each day</h2>
        <div class="stats__columns" style="--axis-max: <%= axis_max %>">
          <div class="stats__grid" aria-hidden="true">
            <% [ axis_max, axis_max / 2.0, 0 ].each do |tick| %>
              <span><%= number_with_delimiter(tick % 1 == 0 ? tick.to_i : tick) %></span>
            <% end %>
          </div>
          <% daily.each do |d| %>
            <% date = d[:date].strftime("%b %-d") %>
            <% tip = d[:future] ? "#{date}: still to come" : d[:hours] ? "#{date}: #{d[:hours]} hours by #{d[:builders]} builders" : "#{date}: fewer than #{PublicStats::MIN_GROUP} builders" %>
            <div class="stats__column" <%= "data-future" if d[:future] %> <%= "data-hidden" if !d[:future] && d[:hours].nil? %>
                 tabindex="0" data-tooltip="<%= tip %>" aria-label="<%= tip %>">
              <span class="stats__column-bar" style="--value: <%= d[:hours] || 0 %>">
                <% if d.equal?(peak) %><span class="stats__column-label"><%= d[:hours] %></span><% end %>
              </span>
              <span class="stats__column-date" aria-hidden="true"><%= d[:date].day %></span>
            </div>
          <% end %>
        </div>
        <p class="stats__axis-note">October · hours</p>
        <details class="stats__table-view">
          <summary>Show as a table</summary>
          <table class="leaderboard__table">
            <thead><tr><th scope="col">Day</th><th class="leaderboard__number" scope="col">Hours</th><th class="leaderboard__number" scope="col">Builders</th></tr></thead>
            <tbody>
              <% daily.reject { |d| d[:future] }.each do |d| %>
                <tr><th scope="row"><%= d[:date].strftime("%b %-d") %></th><td class="leaderboard__number"><%= stat(d[:hours]) %></td><td class="leaderboard__number"><%= stat(d[:builders]) %></td></tr>
              <% end %>
            </tbody>
          </table>
        </details>
      </section>

      <section class="stats__card" aria-labelledby="stats-funnel">
        <h2 class="stats__heading" id="stats-funnel">From signing in to shipping</h2>
        <% first = @stats[:funnel].first[:count] || 0 %>
        <table class="stats__bars">
          <thead class="visually-hidden"><tr><th scope="col">Step</th><th scope="col">People</th><th scope="col">Of everyone who signed in</th></tr></thead>
          <tbody>
            <% @stats[:funnel].each do |step| %>
              <tr>
                <th scope="row"><%= step[:label] %></th>
                <td class="stats__bar-cell">
                  <span class="stats__bar" style="--share: <%= first.positive? && step[:count] ? step[:count].fdiv(first) : 0 %>"></span>
                  <span class="stats__bar-value"><%= stat(step[:count]) %></span>
                </td>
                <td class="stats__bar-share"><%= stat_share(step[:share]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>

      <div class="stats__pair">
        <section class="stats__card" aria-labelledby="stats-tools">
          <h2 class="stats__heading" id="stats-tools">The wrong tools</h2>
          <% most = @stats[:tools].filter_map { |t| t[:builders] }.max || 0 %>
          <table class="stats__bars">
            <thead><tr><th scope="col">Tool</th><th scope="col">Builders</th><th class="stats__bar-share" scope="col">Hours</th></tr></thead>
            <tbody>
              <% @stats[:tools].sort_by { |t| -(t[:builders] || 0) }.each do |tool| %>
                <tr>
                  <th scope="row"><%= tool[:label] %></th>
                  <td class="stats__bar-cell">
                    <span class="stats__bar" style="--share: <%= most.positive? && tool[:builders] ? tool[:builders].fdiv(most) : 0 %>"></span>
                    <span class="stats__bar-value"><%= stat(tool[:builders]) %></span>
                  </td>
                  <td class="stats__bar-share"><%= tool[:builders] ? stat(tool[:hours]) : "" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </section>

        <section class="stats__card" aria-labelledby="stats-streaks">
          <h2 class="stats__heading" id="stats-streaks">Streaks and buddies</h2>
          <div class="stats__tiles stats__tiles--small">
            <div class="stats__tile"><span>On a streak</span><strong><%= stat(streaks[:on_streak]) %></strong></div>
            <div class="stats__tile"><span>Longest streak</span><strong><%= streaks[:longest] ? "#{streaks[:longest]} days" : "—" %></strong></div>
            <div class="stats__tile"><span>Buddy pairs</span><strong><%= stat(streaks[:pairs]) %></strong></div>
          </div>
          <% most = streaks[:groups].filter_map { |g| g[:people] }.max || 0 %>
          <table class="stats__bars">
            <thead><tr><th scope="col">Streak</th><th scope="col">People</th></tr></thead>
            <tbody>
              <% streaks[:groups].each do |group| %>
                <tr>
                  <th scope="row"><%= group[:label] %></th>
                  <td class="stats__bar-cell">
                    <span class="stats__bar" style="--share: <%= most.positive? && group[:people] ? group[:people].fdiv(most) : 0 %>"></span>
                    <span class="stats__bar-value"><%= stat(group[:people]) %></span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </section>
      </div>

      <p class="leaderboard__note">Updated <%= time_ago_in_words(@stats[:generated_at]) %> ago. Hours come from Hackatime and catch up through the day.</p>
      <div class="stats__tooltip" data-stats-tooltip-target="tip" role="tooltip" hidden></div>
    </div>
  </main>
</div>
